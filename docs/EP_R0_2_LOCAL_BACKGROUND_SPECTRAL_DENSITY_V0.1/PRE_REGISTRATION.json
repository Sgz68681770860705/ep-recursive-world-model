    "T3_kernel_relative_L2_error": 1e-05,
    "T4_a_relative_error": 0.01,
    "T4_g_relative_error": 0.01,
    "T5_reversal_configuration_error": 1e-10,
    "T5_reversal_velocity_error": 1e-10,
    "T5_relative_energy_drift": 1e-10
